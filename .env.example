# Copy to .env and adjust. All variables are optional.

# SQLAlchemy connection string. Defaults:
#   local:      mysql+mysqlconnector://root:password@localhost/license_plate
#   production: mysql+mysqlconnector://back:password@db/license_plate  (BACKEND_ENV=production)
DATABASE_URL=mysql+mysqlconnector://root:password@localhost/license_plate

# "production" selects the Docker database host (set automatically in the Dockerfile)
BACKEND_ENV=

# Flask secret key (random on each start if unset)
SECRET_KEY=change-me

# 1 = debug on (default), 0 = off
FLASK_DEBUG=1
